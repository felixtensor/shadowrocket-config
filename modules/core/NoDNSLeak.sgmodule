#!name=No DNS Leak for Main Config
#!desc=国内直连域名使用国内 DoH，代理域名远端解析，失败回退经代理。IPv6 开关由主配置决定，Main.conf 和 Main_no_ipv6.conf 共用本模块

[General]
dns-server = https://dns.alidns.com/dns-query#no-h3,https://doh.pub/dns-query#no-h3
direct-dns-server = https://dns.alidns.com/dns-query#no-h3,https://doh.pub/dns-query#no-h3
fallback-dns-server = https://1.1.1.1/dns-query#proxy
proxy-dns-server = https://dns.alidns.com/dns-query#no-h3,https://doh.pub/dns-query#no-h3
dns-direct-system = false
dns-direct-fallback-proxy = true
private-ip-answer = true
always-ip-address = false
use-local-host-item-for-proxy = false
allow-dns-svcb = false
hijack-dns = *:53
udp-policy-not-supported-behaviour = REJECT
block-quic = all-proxy

[Host]
dns.alidns.com = 223.5.5.5
doh.pub = 1.12.12.12
*.local = server:system
*.lan = server:system
*.home.arpa = server:system
localhost = 127.0.0.1
