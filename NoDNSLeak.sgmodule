#!name=No DNS Leak for Main Config
#!desc=为 Main.conf 提供唯一 DNS 设置，所有公网本地解析只经代理

[General]
dns-server = https://1.1.1.1/dns-query#proxy
fallback-dns-server = https://dns.google/dns-query#proxy
proxy-dns-server = https://dns.alidns.com/dns-query#no-h3,https://doh.pub/dns-query#no-h3
ipv6 = false
prefer-ipv6 = false
ipv6-only-if-no-ipv4-dns = false
dns-direct-system = false
dns-direct-fallback-proxy = true
private-ip-answer = true
always-ip-address = false
use-local-host-item-for-proxy = false
allow-dns-svcb = false
hijack-dns = *:53
udp-policy-not-supported-behaviour = REJECT
block-quic = all-proxy

[Host]
dns.alidns.com = 223.5.5.5
doh.pub = 1.12.12.12
*.local = server:system
*.lan = server:system
*.home.arpa = server:system
localhost = 127.0.0.1
