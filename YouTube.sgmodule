#!name=YouTube Enhance for Main Config
#!desc=iOS / iPadOS 的 YouTube 与 YouTube Music 客户端去广告、画中画与后台播放。需要开启 HTTPS 解密

[Rule]
# 阻断 UDP，让 QUIC 回落到可解密的 HTTPS，否则下面的规则和脚本都看不到流量。
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# 末条把 initplayback 打空，让 player 响应退回明文 v1/player，详见 docs/youtube.md。
(^https?://[\w-]+\.googlevideo\.com/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?://[\w-]+\.googlevideo\.com/(?!(?:dclk_video_ads|videoplayback\?)).+&oad _ reject-200
^https?://(?:www|s)\.youtube\.com/api/stats/ads _ reject-200
^https?://(?:www|s)\.youtube\.com/(?:pagead|ptracking) _ reject-200
^https?://s\.youtube\.com/api/stats/qoe\?adcontext _ reject-200
^https?://[\w-]+\.googlevideo\.com/initplayback.+&ack _ reject-200

[Script]
# argument 传空 JSON 表示使用脚本默认值，可选参数与升级方式见 docs/youtube.md。
youtube_response=type=http-response,pattern=^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:[/?#]|$),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.response.js,argument="{}"

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com,*.googlevideo.com,s.youtube.com,www.youtube.com,youtubei.googleapis.com
